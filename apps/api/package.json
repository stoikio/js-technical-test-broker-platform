{
  "name": "@broker/api",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=migrations --disable-warning=ExperimentalWarning src/main.ts",
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "db:reset": "node --disable-warning=ExperimentalWarning src/scripts/reset-database.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  }
}
